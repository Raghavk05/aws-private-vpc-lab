# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.

aws_region   = "us-east-1"
project_name = "private-vpc-lab"
environment  = "dev"

vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"

instance_type = "t3.micro"

# Set to false to skip the NAT gateway and its hourly charge.
# The instance will have no internet path at all in that mode.
enable_nat_gateway = true
